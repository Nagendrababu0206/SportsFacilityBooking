# Backend Configuration for Sports Facility Booking API
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB (optional - set MOCK_DB=true to skip)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/sports_booking
MONGO_TIMEOUT=10000

# JWT
JWT_SECRET=sfb_secret_2024

# CORS - comma-separated origins allowed
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Set to true to use in-memory database (no MongoDB required)
MOCK_DB=true

# For Render deployment, set these in Render Dashboard:
# MOCK_DB=false, MONGODB_URI=<your_atlas_uri>, JWT_SECRET=<secret>,
# CORS_ORIGIN=https://your-frontend.vercel.app