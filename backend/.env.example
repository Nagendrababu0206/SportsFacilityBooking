# Backend Configuration for Sports Facility Booking API
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (required for production)
# Use the exact URI from MongoDB Atlas > Connect > Drivers
# Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/sports_booking?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/sports_booking?retryWrites=true&w=majority
MONGO_TIMEOUT=10000

# JWT
JWT_SECRET="sfb_secret_2024"

# CORS - comma-separated origins allowed
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Set to false to use MongoDB (recommended for real data)
MOCK_DB=false

# For local demo without MongoDB, use:
# MOCK_DB=true
# (omit MONGODB_URI)
# CORS_ORIGIN=https://your-frontend.vercel.app
